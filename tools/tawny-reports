#!/usr/bin/env bash
# Pull diagnostic reports off the rendezvous Worker into a local folder.
#
#   tawny-reports            drain: fetch + delete from the Worker, append here
#   tawny-reports --peek     fetch without deleting (just look)
#
# Config: ~/.config/tawny-reports.env
#   TAWNY_WORKER=https://tawny-rendezvous.tawny1.workers.dev
#   TAWNY_REPORT_KEY=<the REPORT_KEY secret you set with wrangler>
#
# Output: ~/Documents/Tawny reports/YYYY-MM.ndjson  (one JSON report per line)
set -euo pipefail

CFG="$HOME/.config/tawny-reports.env"
[ -f "$CFG" ] && . "$CFG"
: "${TAWNY_WORKER:?set TAWNY_WORKER in $CFG}"
: "${TAWNY_REPORT_KEY:?set TAWNY_REPORT_KEY in $CFG}"

DRAIN=1
[ "${1:-}" = "--peek" ] && DRAIN=0

OUTDIR="$HOME/Documents/Tawny reports"
mkdir -p "$OUTDIR"
OUT="$OUTDIR/$(date +%Y-%m).ndjson"

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

code=$(curl -sS -o "$TMP" -w '%{http_code}' \
  "$TAWNY_WORKER/report/pull?key=$TAWNY_REPORT_KEY&drain=$DRAIN")

if [ "$code" != "200" ]; then
  echo "pull failed: HTTP $code" >&2
  cat "$TMP" >&2
  exit 1
fi

n=$(grep -c . "$TMP" || true)
if [ "$n" -eq 0 ]; then
  echo "no new reports"
  exit 0
fi

if [ "$DRAIN" = "1" ]; then
  cat "$TMP" >> "$OUT"
  echo "$n new report(s) → $OUT"
else
  echo "$n report(s) on the Worker (not drained):"
fi

# quick summary: time · version · model · android · first line of the log
if command -v jq >/dev/null; then
  jq -r '"  \(.ts)  v\(.v) (\(.c))  \(.model) / Android \(.android)\n    \((.log|split("\n"))[0])"' "$TMP"
else
  echo "  (install jq for a readable summary; raw NDJSON is in $OUT)"
fi
