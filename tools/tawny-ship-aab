#!/usr/bin/env bash
# Build a signed release AAB and file it in the Play Store submission pack,
# one timestamped folder per ship, named so a PR reviewer can tell at a glance
# which build it is and pull it up in Play Console without guessing.
#
# Usage:
#   tawny-ship-aab       build the release AAB, copy it into
#                         "Tawny ship/Google Ready/<YYYYMMDD>-<HHMMSS>-b<build>/" as
#                         app-release-<version>-<YYYYMMDD>-b<build>.aab,
#                         log the git commit it was built from in
#                         Google Ready/MANIFEST.md, and write
#                         Google Ready/<YYYYMMDD>-<HHMMSS>-b<build>/RELEASE-NOTES.md — the
#                         commit log between this build and the last one
#                         shipped, categorized by type and ready to paste into
#                         Play Console as the tester-facing release notes.
#
set -euo pipefail

export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/sdk}"
export JAVA_HOME="${JAVA_HOME:-$HOME/Android/jdk17}"
export PATH="$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$PATH"

PROJECT="$HOME/Downloads/frentalk"
ROOT="$HOME/Documents/Tawny ship/Google Ready"
AAB_SRC="$PROJECT/android/app/build/outputs/bundle/release/app-release.aab"
VPROPS="$PROJECT/android/version.properties"
MANIFEST="$ROOT/MANIFEST.md"

CODE=$(grep "^VERSION_CODE=" "$VPROPS" | cut -d= -f2 | tr -d '[:space:]')
NAME=$(grep "^VERSION_NAME=" "$VPROPS" | cut -d= -f2 | tr -d '[:space:]')
DATE=$(date +%Y%m%d)
TIME=$(date +%H%M%S)
COMMIT=$(git -C "$PROJECT" rev-parse --short HEAD)
BRANCH=$(git -C "$PROJECT" rev-parse --abbrev-ref HEAD)
DIRTY=""
git -C "$PROJECT" diff --quiet && git -C "$PROJECT" diff --cached --quiet \
  || DIRTY=" **(built from uncommitted changes)**"

OUT="app-release-${NAME}-${DATE}-b${CODE}.aab"
DEST="$ROOT/${DATE}-${TIME}-b${CODE}"

mkdir -p "$DEST"

echo "Building release AAB for v$NAME (build $CODE)…"
( cd "$PROJECT/android" && ./gradlew -q :app:bundleRelease )

if [ ! -f "$AAB_SRC" ]; then
  echo "No AAB found at $AAB_SRC" >&2
  exit 1
fi

cp "$AAB_SRC" "$DEST/$OUT"

if command -v jarsigner >/dev/null 2>&1; then
  if ! jarsigner -verify "$DEST/$OUT" >/dev/null 2>&1; then
    echo "WARNING: $OUT does not verify as signed — check keystore.properties" >&2
  fi
fi

# The previous ship's commit — read before this run's row goes in, so the
# diff is against the *last* build, not itself. The AAB-filename cell is also
# backtick-wrapped but always has non-hex characters in it (the .aab
# extension alone rules it out), so a pure-hex backtick span can only be a
# commit hash.
PREV_COMMIT=""
if [ -f "$MANIFEST" ]; then
  PREV_COMMIT=$(grep -oE '`[0-9a-f]{7,40}`' "$MANIFEST" | tail -1 | tr -d '`') || true
fi

if [ ! -f "$MANIFEST" ]; then
  {
    echo "# Google Ready — AAB build log"
    echo ""
    echo "One row per AAB filed here (each under its own <YYYYMMDD>/ folder),"
    echo "with the exact commit it was built from — match an AAB to a"
    echo "PR/commit before pushing it to Play Console."
    echo ""
    echo "| AAB | Version | Build | Date | Commit | Branch |"
    echo "|---|---|---|---|---|---|"
  } > "$MANIFEST"
fi
printf '| `%s/%s` | %s | %s | %s | `%s`%s | %s |\n' \
  "${DATE}-${TIME}-b${CODE}" "$OUT" "$NAME" "$CODE" "$DATE" "$COMMIT" "$DIRTY" "$BRANCH" >> "$MANIFEST"

# Release notes: the commit log from the last shipped build to this one,
# filed next to the AAB it describes so it can be pasted straight into Play
# Console's tester-facing release notes for this build.
NOTES="$DEST/RELEASE-NOTES.md"
{
  echo "# Tawny v$NAME (build $CODE)"
  echo ""
  echo "Built $DATE from \`$COMMIT\` on \`$BRANCH\`.$DIRTY"
  echo ""
  echo "## Changes"
  echo ""
  if [ -z "$PREV_COMMIT" ]; then
    echo "First build tracked in Google Ready — no prior commit on record to diff against."
  elif [ "$PREV_COMMIT" = "$COMMIT" ]; then
    echo "No changes — rebuilt from the same commit as the last ship (\`$PREV_COMMIT\`)."
  elif ! git -C "$PROJECT" cat-file -e "$PREV_COMMIT" 2>/dev/null; then
    echo "Last shipped commit \`$PREV_COMMIT\` is no longer in this repo (rebase/force-push?)" \
      "— can't compute a diff. Full history: \`git log\`."
  else
    LOG=$(git -C "$PROJECT" log --no-merges --pretty=format:'- %s' "$PREV_COMMIT..$COMMIT")
    if [ -z "$LOG" ]; then
      echo "No commits between \`$PREV_COMMIT\` and \`$COMMIT\` (version/build bump only)."
    else
      echo "Since \`$PREV_COMMIT\`:"
      echo ""

      # Categorize commits by type
      declare -a bug_fixes ui_ux features other

      while IFS= read -r line; do
        # Extract message for matching (remove leading "- ")
        msg="${line#- }"

        # Check categories in order (first match wins). Word-boundaries
        # (\b) matter here — without them "ui" matches inside "build" and
        # "new" matches inside "renew", mis-bucketing unrelated commits.
        if echo "$msg" | grep -iqE '\b(fix|fixed|fixes|bug|crash|error|wrong|broken|regression)\b'; then
          bug_fixes+=("$line")
        elif echo "$msg" | grep -iqE '\b(redesign|ui|ux|screen|style|theme|icon|layout|copy|chime|sound|palette|animation|polish)\b'; then
          ui_ux+=("$line")
        elif echo "$msg" | grep -iqE '\b(add|adds|added|new|implement|introduce)\b|support for'; then
          features+=("$line")
        else
          other+=("$line")
        fi
      done <<< "$LOG"

      # Output categorized sections (only non-empty)
      if [ ${#bug_fixes[@]} -gt 0 ]; then
        echo "### Bug Fixes"
        echo ""
        printf '%s\n' "${bug_fixes[@]}"
        echo ""
      fi
      if [ ${#ui_ux[@]} -gt 0 ]; then
        echo "### UI/UX"
        echo ""
        printf '%s\n' "${ui_ux[@]}"
        echo ""
      fi
      if [ ${#features[@]} -gt 0 ]; then
        echo "### Features"
        echo ""
        printf '%s\n' "${features[@]}"
        echo ""
      fi
      if [ ${#other[@]} -gt 0 ]; then
        echo "### Other"
        echo ""
        printf '%s\n' "${other[@]}"
      fi
    fi
  fi
} > "$NOTES"

echo "  ✓ $DEST/$OUT"
echo "  ✓ logged in $MANIFEST"
echo "  ✓ release notes in $NOTES"
