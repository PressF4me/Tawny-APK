<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- DayNight: @color/* resolves from values/ or values-night/. -->
    <style name="Theme.Tawny" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="colorPrimary">@color/berry</item>
    </style>

    <!-- Android 12+ splash: the icon on the ground colour, then hand off. -->
    <style name="Theme.Tawny.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Tawny</item>
    </style>
</resources>
