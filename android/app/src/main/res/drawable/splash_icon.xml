<?xml version="1.0" encoding="utf-8"?>
<!-- The Android 12+ splash icon: the launcher icon's two layers stacked, so the
     splash's own circular mask shows the pink disc behind the cream art. The
     foreground alone is cream on the cream splash ground, and the platform's
     windowSplashScreenIconBackgroundColor did not draw on the emulator
     (API 36, core-splashscreen 1.0.1). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background"/>
    <item android:drawable="@drawable/ic_launcher_foreground"/>
</layer-list>
